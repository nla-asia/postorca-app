{
  "name": "@postorca/api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "eval": "tsx src/scripts/eval.ts",
    "dev": "tsx watch src/index.ts",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "test": "tsx --test --test-concurrency=1 --test-timeout=60000 tests/*.test.ts",
    "db:local": "tsx src/local-db.ts",
    "db:migrate": "tsx src/migrate.ts",
    "browser:eval": "tsx src/scripts/browser-eval.ts",
    "computer:eval": "tsx src/scripts/computer-eval.ts",
    "computer:eval:mac": "tsx src/scripts/computer-eval-mac.ts",
    "test:computer-eval": "tsx --test tests/computer-eval*.test.ts",
    "media:smoke": "tsx src/scripts/media-smoke.ts",
    "video:eval": "tsx src/scripts/video-eval.ts",
    "api:usage": "tsx src/scripts/api-usage.ts",
    "credits:add": "tsx src/scripts/add-credits.ts",
    "db:upgrade-legacy": "tsx src/upgrade-legacy.ts"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "jsonwebtoken": "9.0.3",
    "openai": "7.39.0",
    "pg": "8.23.1",
    "stripe": "20.4.1",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "ipaddr.js": "1.9.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  },
  "optionalDependencies": {
    "@remotion/compositor-darwin-arm64": "4.0.533",
    "@remotion/compositor-darwin-x64": "4.0.533",
    "@remotion/compositor-linux-arm64-gnu": "4.0.533",
    "@remotion/compositor-linux-arm64-musl": "4.0.533",
    "@remotion/compositor-linux-x64-gnu": "4.0.533",
    "@remotion/compositor-linux-x64-musl": "4.0.533",
    "@remotion/compositor-win32-x64-msvc": "4.0.533"
  }
}
