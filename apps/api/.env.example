DATABASE_URL=postgresql://postorca:postorca@127.0.0.1:55433/postorca
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3001
CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Model API keys. Which models Orca, images and transcription use is set in src/settings.ts;
# a key only turns its model on and never chooses one.
# Meta Model API (https://dev.meta.ai/docs) serves chat, images and transcription with one key.
META_MODEL_API_KEY=
# Used only when settings.ts chooses OpenAI; the image key never falls back to the chat key.
OPENAI_API_KEY=
OPENAI_IMAGE_API_KEY=
ELEVENLABS_API_KEY=

# Optional JSON price cards replacing the checked-in rates; missing prices stay unknown.
# API_PRICING_FILE=/absolute/path/to/pricing.json

# Stripe test mode. Plan prices and credits are set in src/billing/terms.ts and
# welcome credits in src/settings.ts; each price ID must match its terms exactly
# (Builder $29/month, Influencer $69/month, Extra credits $20 once, all USD).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BUILDER_PRICE_ID=
STRIPE_INFLUENCER_PRICE_ID=
STRIPE_EXTRA_PRICE_ID=
# Where Stripe sends people after checkout or the billing portal. Locally the API
# serves a plain page; in production use the website's https://orca.atpa.site/billing/return/
BILLING_RETURN_URL=http://127.0.0.1:3001/api/billing/return

# Google connectors (Gmail, Drive). CONNECTOR_ENCRYPTION_KEY is a base64 32-byte key
# that encrypts stored tokens (openssl rand -base64 32).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/connectors/google/callback
CONNECTOR_ENCRYPTION_KEY=
# The connector service; the key matches MCP_SERVER_API_KEY in apps/connectors/.env.
MCP_CONNECTOR_URL=http://127.0.0.1:3100/mcp
MCP_CONNECTOR_API_KEY=
