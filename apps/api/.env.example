DATABASE_URL=postgresql://postorca:postorca@127.0.0.1:55433/postorca
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3001
CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Orca runs turns once a provider's key and model are both set. Meta Model API
# (https://dev.meta.ai/docs) is used when configured; ORCA_PROVIDER=openai|meta overrides.
META_MODEL_API_KEY=
META_MODEL=muse-spark-1.3
OPENAI_API_KEY=
OPENAI_MODEL=
# ORCA_PROVIDER=
# Images use Muse Image (muse-image-1.0) when META_MODEL_API_KEY is set; IMAGE_PROVIDER=openai
# uses OPENAI_IMAGE_API_KEY instead, which never falls back to the chat key.
# IMAGE_PROVIDER=
OPENAI_IMAGE_API_KEY=
ELEVENLABS_API_KEY=

# Optional JSON price cards replacing the checked-in rates; missing prices stay unknown.
# API_PRICING_FILE=/absolute/path/to/pricing.json

# Test-mode membership and credit terms; set PostOrca's own prices.
WELCOME_CREDITS=250
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MEMBERSHIP_PRICE_ID=
STRIPE_EXTRA_PRICE_ID=
# Public browser return page; change host/port for your deployed API.
BILLING_RETURN_URL=http://127.0.0.1:3001/api/billing/return
