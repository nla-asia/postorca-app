DATABASE_URL=postgresql://postorca:postorca@127.0.0.1:55433/postorca
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3001
CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Orca's model, chosen explicitly; Orca is off while these are unset.
# meta: muse-spark-1.3 or muse-wonder-1.0 · openai: gpt-6-luna
ORCA_PROVIDER=meta
ORCA_MODEL=muse-spark-1.3
# The image model, chosen explicitly; image tools are off while these are unset.
# meta: muse-image-1.0 · openai: gpt-image-2.5-flare
IMAGE_PROVIDER=meta
IMAGE_MODEL=muse-image-1.0
# Provider keys are credentials only; they never choose a model.
# Meta Model API (https://dev.meta.ai/docs) serves both chat and images with one key.
META_MODEL_API_KEY=
OPENAI_API_KEY=
# The OpenAI image key never falls back to the chat key.
OPENAI_IMAGE_API_KEY=
ELEVENLABS_API_KEY=

# Optional JSON price cards replacing the checked-in rates; missing prices stay unknown.
# API_PRICING_FILE=/absolute/path/to/pricing.json

# Test-mode membership and credit terms; set PostOrca's own prices.
WELCOME_CREDITS=250
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MEMBERSHIP_PRICE_ID=
STRIPE_EXTRA_PRICE_ID=
# Public browser return page; change host/port for your deployed API.
BILLING_RETURN_URL=http://127.0.0.1:3001/api/billing/return
