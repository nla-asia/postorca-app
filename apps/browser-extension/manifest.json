{
  "manifest_version": 3,
  "name": "PostOrca Browser Bridge",
  "version": "0.2.0",
  "description": "Connect PostOrca or a compatible local AI agent to Chrome for browser tasks using your existing sign-ins.",
  "minimum_chrome_version": "125",
  "homepage_url": "https://orca.atpa.site",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "debugger",
    "tabGroups",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "PostOrca Browser Bridge",
    "default_popup": "popup.html"
  },
  "key": ""
}
