{
  "name": "@postorca/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k --success first \"npm run dev:renderer\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "start": "electron ."
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.5",
    "electron": "44.9.2",
    "typescript": "5.7.3",
    "vite": "6.4.4",
    "wait-on": "8.0.5"
  }
}
