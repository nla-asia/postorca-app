{
  "name": "@postorca/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k --success first \"npm run dev:renderer\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && npm run video:bundle",
    "start": "electron .",
    "test": "node --test \"electron/tools/*.test.cjs\" \"electron/plugins/*/*.test.cjs\"",
    "computer:build-native": "node scripts/build-computer-native.cjs",
    "computer:smoke": "electron electron/plugins/computer/smoke.cjs",
    "test:computer": "node --test electron/plugins/computer/*.test.cjs",
    "computer:live-check": "electron electron/plugins/computer/live-check.cjs",
    "video:bundle": "node electron/plugins/video/bundle.cjs",
    "video:smoke": "electron electron/plugins/video/smoke.cjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@remotion/captions": "4.0.533",
    "@remotion/elevenlabs": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "lucide-react": "0.468.0",
    "playwriter": "0.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.533",
    "robotjs": "0.9.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.533",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.5",
    "electron": "44.9.2",
    "typescript": "5.7.3",
    "vite": "6.4.4",
    "wait-on": "8.0.5"
  }
}
