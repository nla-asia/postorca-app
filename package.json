{
  "name": "postorca",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/website"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @postorca/desktop",
    "check": "npm run check --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "npm start --workspace @postorca/desktop",
    "desktop:package": "npm run package --workspace @postorca/desktop",
    "api:dev": "npm run dev --workspace @postorca/api",
    "api:start": "npm start --workspace @postorca/api",
    "connectors:dev": "npm run dev --workspace @postorca/connectors",
    "connectors:start": "npm run start --workspace @postorca/connectors",
    "connectors:build": "npm run build --workspace @postorca/connectors",
    "connectors:test": "npm run test --workspace @postorca/connectors",
    "test": "npm run test --workspaces --if-present",
    "db:local": "npm run db:local --workspace @postorca/api",
    "db:migrate": "npm run db:migrate --workspace @postorca/api",
    "web:dev": "npm run dev --workspace @postorca/website",
    "web:build": "npm run build --workspace @postorca/website",
    "web:start": "npm run start --workspace @postorca/website",
    "computer:smoke": "npm run computer:smoke --workspace @postorca/desktop",
    "test:computer": "npm run test:computer --workspace @postorca/desktop",
    "computer:live-check": "npm run computer:live-check --workspace @postorca/desktop",
    "browser:eval": "npm run browser:eval --workspace @postorca/api --",
    "computer:eval": "npm run computer:eval --workspace @postorca/api --",
    "computer:eval:mac": "npm run computer:eval:mac --workspace @postorca/api --",
    "test:computer-eval": "npm run test:computer-eval --workspace @postorca/api",
    "video:bundle": "npm run video:bundle --workspace @postorca/desktop",
    "video:smoke": "npm run video:smoke --workspace @postorca/desktop",
    "media:smoke": "npm run media:smoke --workspace @postorca/api",
    "video:eval": "npm run video:eval --workspace @postorca/api --",
    "api:usage": "npm run api:usage --workspace @postorca/api --",
    "deploy": "bash scripts/deploy.sh",
    "desktop:package:prod": "bash scripts/package-desktop-prod.sh",
    "version:set": "node scripts/set-version.mjs",
    "release": "bash scripts/release.sh"
  }
}
