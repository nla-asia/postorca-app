[Unit]
Description=PostOrca MCP connectors
After=network.target

[Service]
User=nika
WorkingDirectory=/opt/postorca/apps/connectors
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/postorca/apps/connectors/dist/src/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
