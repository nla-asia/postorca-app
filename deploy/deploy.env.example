# Copy to ~/.config/postorca/deploy.env (outside the repository) and fill in.
# Read by scripts/deploy.sh, scripts/release.sh and npm run desktop:package:prod.
# Set POSTORCA_DEPLOY_ENV to use a different file.

# SSH user@host for the production VM.
POSTORCA_DEPLOY_HOST=user@your-server
# SSH private key for that host.
POSTORCA_DEPLOY_KEY=$HOME/.ssh/id_ed25519
# Public API URL baked into production desktop builds.
POSTORCA_API_URL=https://your-server/api
